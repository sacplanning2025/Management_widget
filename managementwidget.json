{
  "id": "com.company.managementwidget",
  "version": "2.0.0",
  "name": "Project Entry Widget",
  "description": "Management mapping table widget for SAC",
  "vendor": "NTT",
  "newInstancePrefix": "ProjectEntryWidget",
  "icon": "sap-icon://table-view",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-company-managementwidget",
      "url": "https://sacplanning2025.github.io/Management_widget/managementwidget.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "rows": { "type": "string", "default": "[]" },
    "managedata": { "type": "string", "default": "[]" },
    "activetab": { "type": "string", "default": "create" },
    "lastEvent": { "type": "string", "default": "" },
    "validationResult": { "type": "string", "default": "true" },
    "validationErrors": { "type": "string", "default": "[]" },
    "savePayload": { "type": "string", "default": "[]" },
    "rowCount": { "type": "integer", "default": 0 },
    "selectedRowCount": { "type": "integer", "default": 0 },
    "widgetStatus": { "type": "string", "default": "READY" },

    "glAccountOptions": { "type": "string", "default": "[]" },
    "costCenterOptions": { "type": "string", "default": "[]" },
    "profitCenterOptions": { "type": "string", "default": "[]" },
    "segmentOptions": { "type": "string", "default": "[]" },
    "hierarchyOptions": { "type": "string", "default": "[]" },
    "managementMappingOptions": { "type": "string", "default": "[]" },
    "managementSubMappingOptions": { "type": "string", "default": "[]" }
  },
  "methods": {
    "getRows": {
      "description": "Get create mapping rows",
      "returnType": "string"
    },
    "setRows": {
      "description": "Set create mapping rows",
      "parameters": [
        { "name": "rowsJson", "type": "string" }
      ]
    },
    "getManageData": {
      "description": "Get manage mapping rows",
      "returnType": "string"
    },
    "setManageData": {
      "description": "Set manage mapping rows",
      "parameters": [
        { "name": "rowsJson", "type": "string" }
      ]
    },
    "setActiveTab": {
      "description": "Set active tab",
      "parameters": [
        { "name": "tabName", "type": "string" }
      ]
    },
    "getRowCount": {
      "returnType": "integer"
    },
    "getSelectedRowCount": {
      "returnType": "integer"
    },
    "getRowValue": {
      "parameters": [
        { "name": "rowIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" }
      ],
      "returnType": "string"
    },
    "getSelectedRowValue": {
      "parameters": [
        { "name": "selectedIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" }
      ],
      "returnType": "string"
    },
    "addRow": {
      "description": "Add row in create mapping"
    },
    "copySelectedRows": {
      "description": "Copy selected rows in create mapping"
    },
    "deleteSelectedRows": {
      "description": "Delete selected rows in create mapping"
    },
    "clear": {
      "description": "Clear active tab data"
    },
    "validate": {
      "description": "Validate create mapping only",
      "returnType": "string"
    },
    "save": {
      "description": "Save create mapping selected rows"
    },
    "loadManageData": {
      "description": "Trigger load for manage mapping"
    },
    "saveManageData": {
      "description": "Trigger save for manage mapping"
    },
    "deleteManageData": {
      "description": "Trigger delete for manage mapping"
    },
    "getValidationErrors": {
      "returnType": "string"
    },
    "getValidationResult": {
      "returnType": "string"
    },
    "setGlAccountOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setGLAccountOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setCostCenterOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setProfitCenterOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setSegmentOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setHierarchyOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setManagementMappingOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setManagementSubMappingOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setRowFieldOptions": {
      "description": "Set create row field options",
      "parameters": [
        { "name": "rowIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" },
        { "name": "json", "type": "string" }
      ]
    },
    "setManageRowFieldOptions": {
      "description": "Set manage row field options",
      "parameters": [
        { "name": "rowIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" },
        { "name": "json", "type": "string" }
      ]
    },
    "getLastEvent": {
      "returnType": "string"
    }
  },
  "events": {
    "onFieldChange": {},
    "onDataChange": {},
    "onValidate": {},
    "onReady": {}
  }
}
